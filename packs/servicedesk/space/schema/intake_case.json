{
  "title": "Intake case",
  "description": "A case submitted through the public form.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 160
    },
    "category": {
      "type": "string",
      "enum": [
        "no_signal",
        "slow_data",
        "billing",
        "device",
        "capacity",
        "other"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "contact_msisdn": {
      "type": "string",
      "pattern": "^\\+9647[0-9]0000[0-9]{4}$"
    },
    "contact_name": {
      "type": "string",
      "maxLength": 80
    },
    "city": {
      "type": "string",
      "maxLength": 60
    }
  },
  "required": [
    "title",
    "category",
    "contact_msisdn"
  ]
}
