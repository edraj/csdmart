{
  "type": "object",
  "title": "Landing page",
  "description": "The text of a website's home page. Its layout, icons and figures come from the site template (dmart website build). Markdown fields are rendered with raw HTML disabled.",
  "required": [
    "hero"
  ],
  "additionalProperties": false,
  "properties": {
    "hero": {
      "type": "object",
      "required": [
        "title_lines"
      ],
      "additionalProperties": false,
      "properties": {
        "badge": {
          "type": "string"
        },
        "title_lines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 3,
          "description": "The last line gets the accent style when there is more than one"
        },
        "subtitle": {
          "type": "string",
          "description": "Inline markdown"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "href"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "href": {
                "type": "string",
                "description": "A URL, or a root-relative path such as /features; paths to pages of this site are rewritten to wherever the site is served"
              },
              "style": {
                "type": "string",
                "enum": [
                  "primary",
                  "secondary",
                  "link"
                ]
              }
            }
          }
        },
        "figure": {
          "type": "string",
          "description": "Name of a figure shipped with the site template, e.g. architecture"
        }
      }
    },
    "stats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "value",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "cards",
              "steps",
              "figures",
              "prose",
              "banner"
            ]
          },
          "title": {
            "type": "string"
          },
          "accent": {
            "type": "string",
            "description": "banner only: a second, emphasised title line"
          },
          "body": {
            "type": "string",
            "description": "Markdown"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string"
                },
                "body": {
                  "type": "string",
                  "description": "Markdown"
                },
                "href": {
                  "type": "string"
                },
                "icon": {
                  "type": "string",
                  "description": "Name of an icon shipped with the site template"
                }
              }
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "href"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string"
                },
                "href": {
                  "type": "string",
                  "description": "A URL, or a root-relative path such as /features; paths to pages of this site are rewritten to wherever the site is served"
                },
                "style": {
                  "type": "string",
                  "enum": [
                    "primary",
                    "secondary",
                    "link"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
