{
  "type": "object",
  "title": "Site configuration",
  "description": "Brand, header links, docs sidebar and footer of a website built with dmart website build.",
  "required": [
    "brand"
  ],
  "additionalProperties": false,
  "properties": {
    "brand": {
      "type": "string"
    },
    "title_suffix": {
      "type": "string",
      "description": "Appended to every page title except the home page's"
    },
    "base_url": {
      "type": "string",
      "description": "Public origin, e.g. https://dmart.cc — canonical links and sitemap.xml need it; --base overrides"
    },
    "header_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "href"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "href": {
            "type": "string"
          },
          "docs": {
            "type": "boolean",
            "description": "Marked current on every page in the docs sidebar"
          }
        }
      }
    },
    "nav": {
      "type": "array",
      "description": "Docs sidebar groups. Pages listed here render with the sidebar; the rest render standalone.",
      "items": {
        "type": "object",
        "required": [
          "title",
          "items"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "page"
              ],
              "additionalProperties": false,
              "properties": {
                "page": {
                  "type": "string",
                  "description": "The page's slug (or shortname when it has none)"
                },
                "label": {
                  "type": "string",
                  "description": "Sidebar label; defaults to the page title"
                }
              }
            }
          }
        }
      }
    },
    "footer": {
      "type": "string",
      "description": "Markdown"
    }
  }
}
