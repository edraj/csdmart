# Secrets

# Frontend build artifacts (source is committed, dist is rebuilt). The
# yarn workspace at repo root hoists most deps into /node_modules; the
# per-package node_modules directories still exist as symlink stubs.
/node_modules/
cxb/node_modules/
cxb/dist/
cxb/.svelte-kit/
catalog/node_modules/
catalog/dist/
catalog/.svelte-kit/
config.env
dmart
dmart (2)/
*.tar.gz

# RPM build output
dist/out/

# Staged binary from container builder
admin_scripts/docker/dmart-binary

# Test coverage output (regenerated by `dotnet test --collect:"XPlat Code Coverage"`)
dmart.Tests/TestResults/
.codex
dotnet-tools.json

# Claude Code writes settings atomically via transient temp files; two were
# committed accidentally by a `git add -A`.
.claude/*.tmp.*

# packages.lock.json is deliberately NOT committed — see dist/deps/README.md.
# The SDK writes its own ILCompiler/ILLink.Tasks versions AND content hashes
# into a lock file, and distro .NET builds (Fedora, AlmaLinux) resolve those
# from a local library-packs folder whose hashes differ from nuget.org's. A
# committed lock file fails NU1403 on every one of those builders. The
# reviewable dependency graph lives under dist/deps/ instead, where MSBuild
# never reads it.
packages.lock.json

# Shared linux-x64 binary downloaded by the packaging jobs (see
# DMART_PREBUILT_BIN in dist/build-rpm.sh and dist/build-deb.sh).
/prebuilt/
