# dmart — packaged default configuration (/etc/dmart/config.env)
#
# Seeded on FIRST INSTALL only; your edits survive upgrades. The full,
# annotated list of every supported key lives at
# /usr/share/dmart/config.env.sample — this file is deliberately short: it is
# the handful of settings a packaged install actually needs.
#
# The service runs as user `dmart` with WorkingDirectory=/var/lib/dmart, and
# systemd's StateDirectory= creates the paths below before ExecStart fires.

# ---- required before the service will start ----
# Must be at least 32 bytes and must not contain "change-me" — dmart refuses to
# boot on the placeholder rather than signing tokens with a publicly known key.
# Generate one with:  openssl rand -base64 48
JWT_SECRET="change-me-change-me-change-me-32b-minimum-length"

# ---- storage ----
# The flat files under SPACES_FOLDER are the source of truth. The SQL store is
# a rebuildable index over them — `dmart import <spaces-folder>` reconstructs it.
SPACES_FOLDER="/var/lib/dmart/spaces"

# Packaged installs default to SQLite so a fresh install serves without
# standing up a database server first. It is a REDUCED TIER — dev, CI,
# single-node and edge — not a second production-grade backend. Read the
# "Storage backends" section of the readme before running it under real load;
# the short version is that JSON-payload filters and the row-level ACL filter
# run unindexed, so query cost grows with corpus size in a way it does not on
# PostgreSQL.
DATABASE_DRIVER="sqlite"
SQLITE_PATH="/var/lib/dmart/dmart.db"

# ---- switching to PostgreSQL ----
# Set DATABASE_DRIVER="postgresql" AND fill in the connection below. Both are
# required: the driver line is pinned here on purpose, so editing the
# connection alone will not silently move you between backends.
#
# The SQL store is rebuildable, so migrating is: stop dmart, point these at the
# new database, `dmart migrate`, then `dmart import /var/lib/dmart/spaces`.
#
# DATABASE_HOST="localhost"
# DATABASE_PORT=5432
# DATABASE_USERNAME="dmart"
# DATABASE_PASSWORD=""
# DATABASE_NAME="dmart"

# ---- network ----
LISTENING_HOST="0.0.0.0"
LISTENING_PORT=5099

# ---- logging ----
LOG_LEVEL="information"
LOG_FORMAT="json"
